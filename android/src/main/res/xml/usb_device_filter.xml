<?xml version="1.0" encoding="utf-8"?>
<!--
  USB device filter for auto-launching the host app when a Zebra printer is plugged in.
  Consumers opt in by referencing this file in their own AndroidManifest activity:

    <activity ...>
      <intent-filter>
        <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
      </intent-filter>
      <meta-data
        android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
        android:resource="@xml/usb_device_filter"/>
    </activity>

  2655 = 0x0A5F = Zebra Technologies USB-IF vendor ID.
-->
<resources>
  <usb-device vendor-id="2655"/>
</resources>
